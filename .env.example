# Read at build by `npm run build`/SWA. The Docker image instead reads both as container env vars at start (runtime-env.sh).
VITE_API_BASE_URL=http://localhost:5103/api/v1
# Public portal origin, the same value as the API's Portal:BaseUrl; canonical links use it. Optional: the serving origin is the fallback.
# VITE_SITE_URL=https://portal.example.go.id
