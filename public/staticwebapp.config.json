{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{png,jpg,jpeg,gif,svg,webp,ico,pdf,css,js,woff,woff2,txt,xml,json}"]
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-cache" } }
  ],
  "globalHeaders": { "Cache-Control": "no-cache", "Referrer-Policy": "strict-origin-when-cross-origin" }
}
